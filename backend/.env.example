# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string
DATABASE_URL=postgresql+psycopg2://postgres:Godsman.no1.INC@localhost:5432/Teacher

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=jebfbfrbdjscbvcvfuvfjxxj

ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Bootstrap super admin — created automatically on first startup if no
# super_admin exists yet. Change the password immediately after first login,
# then it's safe to remove these two lines from .env.
BOOTSTRAP_SUPER_ADMIN_USERNAME=superadmin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=changeme-strong-password

# Directory where uploaded school logos are stored
UPLOAD_DIR=uploads/logos

# CORS - comma separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Per-account brute-force lockout (separate from the per-IP rate limit on
# the login endpoint itself)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Session cookie behavior. Set COOKIE_SECURE=true for any real deployment
# (cookie only sent over HTTPS) — false is only for local http://
# development. See README > Security for SameSite guidance if the frontend
# and backend end up on different registrable domains.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
